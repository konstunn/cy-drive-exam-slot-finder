{
  "name": "cy-drive-exam-slot-finder",
  "version": "1.0.0",
  "description": "A Telegram bot for finding available driving exam slots",
  "main": "src/index.ts",
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node --test tests/*.browser.ts",
    "test-scraper": "node --env-file=.env scripts/test-scraper.ts"
  },
  "keywords": [
    "telegram",
    "bot",
    "scraper",
    "driving-exam"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "^26.13.0"
  },
  "dependencies": {
    "node-telegram-bot-api": "^1.1.2",
    "puppeteer": "^25.16.0"
  },
  "allowScripts": {
    "puppeteer@25.16.0": true
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
