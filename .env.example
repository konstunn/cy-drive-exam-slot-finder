# Environment variables for the Driving Exam Slot Finder Bot
# Copy this file to .env and fill in your actual values

# Telegram Bot Token (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Scraper credentials for the driving exam booking system
SCRAPER_USERNAME="your_username_here"
SCRAPER_PASSWORD="your_password_here"
SCRAPER_CAR_PLATE="your_car_plate_here"
SCRAPER_CITY_CENTER="your_city_center_here"
SCRAPER_DRIVING_CATEGORY="your_driving_category_here"

# Optional diagnostics: test-scraper enables capture by default; use 0 to disable.
# SCRAPER_DEBUG=1
# SCRAPER_DEBUG_DIR=debug

# Set to 0 to disable all artificial pauses (including the final browser pause).
# SCRAPER_DELAY_SCALE=1
# SCRAPER_NAV_DELAY_MS=0
